# Optional custom contact form endpoint (defaults to FormSubmit sending to einitiative92@gmail.com)
# Example with Formspree: VITE_CONTACT_FORM_ENDPOINT=https://formspree.io/f/your_form_id
# Example with Web3Forms: VITE_CONTACT_FORM_ENDPOINT=https://api.web3forms.com/submit
# VITE_CONTACT_FORM_ENDPOINT=https://formsubmit.co/ajax/einitiative92@gmail.com

# Paystack Public Key for online donations (get from your Paystack Dashboard -> Settings -> API Keys)
# VITE_PAYSTACK_PUBLIC_KEY=pk_live_your_actual_paystack_public_key
VITE_PAYSTACK_PUBLIC_KEY=pk_test_sample_key
